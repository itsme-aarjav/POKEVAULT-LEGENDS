# ==============================================================================
# POKÉVAULT LEGENDS — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=5001
HOST=0.0.0.0
NODE_ENV=production

# MySQL Database Configuration (AWS RDS / Docker Container / Local)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=pokevault
MYSQL_PASSWORD=pokevault_secret
MYSQL_DATABASE=pokevault

# Admin Panel Secret Key (Used for curator access & REST API authentication)
# Set this to a strong random passphrase (minimum 16 characters)
ADMIN_SECRET_KEY=pokevaultadmin123

# PayPal Payment Gateway (Optional for demo mode)
PAYPAL_CLIENT_ID=your-paypal-client-id-here
PAYPAL_CLIENT_SECRET=your-paypal-client-secret-here

# Production Storefront Origin (Used for CORS whitelisting & ALB)
STOREFRONT_ORIGIN=http://localhost
