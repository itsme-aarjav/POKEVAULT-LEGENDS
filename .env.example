# PokeVault Legends environment configuration example

# Server Configuration
PORT=5001
HOST=0.0.0.0
NODE_ENV=production

# MySQL Database Configuration (pokevault-mysql for Kubernetes, 127.0.0.1 for local)
MYSQL_HOST=pokevault-mysql
MYSQL_PORT=3306
MYSQL_USER=pokevault
MYSQL_PASSWORD=your-secure-mysql-password
MYSQL_DATABASE=pokevault

# Admin Panel Secret Key & JWT Signing Secret
ADMIN_SECRET_KEY=your-secure-admin-master-key
JWT_SECRET=your-secure-jwt-signing-key-min-32-chars

# PayPal Payment Gateway (Optional for demo mode)
PAYPAL_CLIENT_ID=your-paypal-client-id-here
PAYPAL_CLIENT_SECRET=your-paypal-client-secret-here

# Production Storefront Origin (Used for CORS whitelisting & ALB)
STOREFRONT_ORIGIN=*
